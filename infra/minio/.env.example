# Credenciais ROOT usados apenas para administracao e nao para a aplicacao
MINIO_ROOT_USER=nowbox-admin
MINIO_ROOT_PASSWORD=

# Usuario da aplicacao com menor privilegio
MINIO_APP_ACCESS_KEY=nowbox-app
MINIO_APP_SECRET_KEY=

MINIO_BUCKET=nowbox

# Bucket exclusivo dos contratos de aluguel
MINIO_BUCKET_CONTRATOS=nowbox-contratos
# nowbox-jobs: somente grava contratos
MINIO_JOBS_ACCESS_KEY=nowbox-jobs
MINIO_JOBS_SECRET_KEY=
# nowbox-api: somente le contratos
MINIO_API_ACCESS_KEY=nowbox-api
MINIO_API_SECRET_KEY=

MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
